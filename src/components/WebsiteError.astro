---
---

<div class="error-container" id="website-error">

    <!-- Fake loading screen -->
    <div class="loading-screen" id="loading-screen">
        <div class="loading-spinner"></div>

        <div class="loading-title">
            Loading survey responses...
        </div>

        <div class="loading-status" id="loading-status">
            Connecting to response server...
        </div>

        <div class="loading-progress">
            <div class="loading-progress-bar" id="loading-progress-bar"></div>
        </div>
    </div>


    <!-- Error dialog -->
    <div class="error-overlay" id="error-overlay">

        <div class="error-modal">

            <div class="error-icon">
                !
            </div>

            <h2 id="error-title">
                Something went wrong
            </h2>

            <p id="error-message">
                We were unable to load the responses for this week's survey.
            </p>

            <div class="error-details" id="error-details">

                <div>
                    <span>Status:</span>
                    <strong>500 Internal Server Error</strong>
                </div>

                <div>
                    <span>Error:</span>
                    <strong>ERR_RESPONSE_LOAD_FAILED</strong>
                </div>

                <div>
                    <span>Reference:</span>
                    <strong id="reference-code">---</strong>
                </div>

            </div>

            <p class="error-help" id="error-help">
                Please try refreshing the page. If the problem persists,
                please try again later.
            </p>

            <button id="error-button">
                Try Again
            </button>

        </div>

    </div>

</div>


<script>
    const loadingScreen = document.getElementById('loading-screen');
    const loadingStatus = document.getElementById('loading-status');
    const progressBar = document.getElementById('loading-progress-bar');

    const errorOverlay = document.getElementById('error-overlay');
    const errorButton = document.getElementById('error-button');

    const errorTitle = document.getElementById('error-title');
    const errorMessage = document.getElementById('error-message');
    const errorHelp = document.getElementById('error-help');

    const referenceCode = document.getElementById('reference-code');


    /*
     * Generate a fake error reference number.
     */
    function generateReference() {
        return Math.random()
            .toString(16)
            .substring(2, 10)
            .toUpperCase();
    }


    /*
     * Update the fake loading progress.
     */
    function updateProgress(percent: number, message: string) {
        if (progressBar) {
            progressBar.style.width = `${percent}%`;
        }

        if (loadingStatus) {
            loadingStatus.textContent = message;
        }
    }


    /*
     * Start the fake loading sequence.
     */
    setTimeout(() => {
        updateProgress(
            20,
            'Connecting to response server...'
        );
    }, 3000);


    setTimeout(() => {
        updateProgress(
            45,
            'Downloading response data...'
        );
    }, 8000);


    setTimeout(() => {
        updateProgress(
            70,
            'Validating response data...'
        );
    }, 13000);


    setTimeout(() => {
        updateProgress(
            88,
            'Processing responses...'
        );
    }, 18000);


    setTimeout(() => {
        updateProgress(
            100,
            'Response validation failed.'
        );
    }, 22000);


    /*
     * Show the fake error after the loading sequence.
     */
    setTimeout(() => {

        if (loadingScreen) {
            loadingScreen.classList.add('hidden');
        }

        if (errorOverlay) {
            errorOverlay.classList.add('visible');
        }

        if (referenceCode) {
            referenceCode.textContent = generateReference();
        }

    }, 26000);


    /*
     * What happens when the user clicks "Try Again".
     */
    errorButton?.addEventListener('click', () => {

        if (!errorTitle || !errorMessage || !errorHelp || !errorButton) {
            return;
        }

        errorTitle.textContent = 'Unable to load content';

        errorMessage.textContent =
            'The server returned an unexpected response while processing the survey data.';

        errorHelp.textContent =
            'The problem may be temporary. Please try again later.';

        errorButton.textContent = 'Reload Page';

        if (referenceCode) {
            referenceCode.textContent = generateReference();
        }

        errorButton.onclick = () => {
            window.location.reload();
        };

    });
</script>


<style>

    /*
     * Main container
     */

    .error-container {
        position: relative;

        width: 100%;
        min-height: 400px;

        font-family:
            Arial,
            Helvetica,
            sans-serif;
    }


    /*
     * Fake loading screen
     */

    .loading-screen {

        min-height: 400px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        text-align: center;

        color: #444;
    }

    .loading-screen.hidden {
        display: none;
    }


    .loading-spinner {

        width: 42px;
        height: 42px;

        margin-bottom: 22px;

        border: 4px solid #ddd;
        border-top-color: #555;

        border-radius: 50%;

        animation: spin 1s linear infinite;
    }


    @keyframes spin {

        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

    }


    .loading-title {

        font-size: 18px;
        font-weight: 600;

        margin-bottom: 8px;
    }


    .loading-status {

        font-size: 14px;

        color: #777;

        min-height: 20px;
    }


    .loading-progress {

        width: min(350px, 80%);

        height: 6px;

        margin-top: 25px;

        background: #e5e5e5;

        border-radius: 3px;

        overflow: hidden;
    }


    .loading-progress-bar {

        width: 0%;

        height: 100%;

        background: #666;

        transition: width 0.4s ease;
    }


    /*
     * Error overlay
     */

    .error-overlay {

        display: none;

        position: fixed;

        inset: 0;

        z-index: 99999;

        align-items: center;
        justify-content: center;

        padding: 20px;

        background:
            rgba(0, 0, 0, 0.65);
    }


    .error-overlay.visible {
        display: flex;
    }


    /*
     * Error dialog
     */

    .error-modal {

        width: min(500px, 100%);

        padding: 32px;

        background: white;

        color: #222;

        border-radius: 8px;

        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.4);

        animation:
            errorAppear 0.25s ease-out;
    }


    @keyframes errorAppear {

        from {
            opacity: 0;
            transform: scale(0.96);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }

    }


    /*
     * Error icon
     */

    .error-icon {

        width: 44px;
        height: 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 18px;

        border-radius: 50%;

        background: #d93025;

        color: white;

        font-size: 28px;
        font-weight: bold;
    }


    /*
     * Text
     */

    .error-modal h2 {

        margin: 0 0 16px;

        font-size: 24px;
        font-weight: 600;
    }


    .error-modal p {

        margin: 0 0 16px;

        line-height: 1.5;
    }


    .error-help {

        color: #666;

        font-size: 14px;
    }


    /*
     * Technical error information
     */

    .error-details {

        margin: 22px 0;

        padding: 14px 16px;

        background: #f5f5f5;

        border: 1px solid #ddd;

        border-radius: 5px;

        font-family:
            "Courier New",
            monospace;

        font-size: 12px;
    }


    .error-details div {

        display: flex;

        justify-content: space-between;

        gap: 20px;

        margin: 6px 0;
    }


    .error-details span {

        color: #666;
    }


    .error-details strong {

        text-align: right;

        font-weight: normal;

        color: #333;
    }


    /*
     * Button
     */

    .error-modal button {

        display: block;

        margin-left: auto;

        margin-top: 24px;

        padding: 10px 24px;

        border: none;

        border-radius: 4px;

        background: #1a73e8;

        color: white;

        font-size: 14px;

        cursor: pointer;
    }


    .error-modal button:hover {

        background: #1557b0;
    }


    /*
     * Mobile
     */

    @media (max-width: 600px) {

        .error-modal {

            padding: 24px;
        }

        .error-details div {

            flex-direction: column;

            gap: 2px;
        }

        .error-details strong {

            text-align: left;
        }

    }

</style>